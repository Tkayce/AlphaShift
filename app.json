{
  "expo": {
    "name": "AlphaShift",
    "slug": "AlphaShift",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/AlphaShift.png",
    "scheme": "alphashift",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dreh.AlphaShift.Game"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/AlphaShift.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "android": {
            "image": "./assets/images/AlphaShift.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4286f2cb-fb11-4b2f-b811-f4007fe67c7f"
      }
    },
    "owner": "dreh"
  }
}
